APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=coffeeshop_menu_order
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Payment
# ---------------------------------------------------------------------------
# Supported gateways: manual, midtrans, xendit
PAYMENT_GATEWAY=manual
# Minutes a QRIS payment stays valid before the order is auto-cancelled
PAYMENT_EXPIRY_MINUTES=15

# Manual gateway: the merchant's own static QRIS. Put the image under public/
# (e.g. public/images/qris-static.png) or use an absolute URL. Leave empty to
# show a "pay at the cashier" notice instead of a broken code. The manual
# gateway has NO webhook: settlement is confirmed by a cashier.
MANUAL_QRIS_IMAGE=
MERCHANT_NAME="Kedai Kopi Kita"

# Midtrans (Dynamic QRIS). Server key is required for real charges and for
# SHA512 webhook signature verification. Leave empty to run in mock mode.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit (Dynamic QRIS). The callback token is verified against the
# x-callback-token header on every webhook request.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
